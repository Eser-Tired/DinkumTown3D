; Engine configuration file.
; Dinkum-style 3D outback town — procedurally generated, no external assets.

config_version=5

[application]

config/name="Dinkum Town 3D"
config/description="Low-poly Australian outback town sandbox (procedural, Godot 4.7)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/quit_on_go_back=false

[autoload]

GameBus="*res://scripts/game_bus.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.62, 0.75, 0.86, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_ticks_per_second=60

[debug]

gdscript/warnings/enable=false
